{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geleias-da-beca",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "geleias-da-beca",
      "database_id": "b997b8f6-5d32-4d80-866d-3ee66cf71bb7"
    }
  ],
  "routes": [{ "pattern": "geleias.familiawerner.org", "custom_domain": true }],
  // Preencha depois de criar o aplicativo no Cloudflare Access (Zero Trust).
  // TEAM_DOMAIN: algo como "seu-time.cloudflareaccess.com". POLICY_AUD: "Application Audience (AUD) Tag".
  // Enquanto estiverem vazios, a API fica fechada.
  "vars": {
    "TEAM_DOMAIN": "",
    "POLICY_AUD": ""
  }
}
