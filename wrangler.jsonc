{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geleias-da-beca",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "geleias-da-beca",
      "database_id": "b997b8f6-5d32-4d80-866d-3ee66cf71bb7"
    }
  ],
  "routes": [{ "pattern": "geleias.familiawerner.org", "custom_domain": true }],
  // Cloudflare Access (Zero Trust): domínio do time e AUD da aplicação "Geleias da Beca".
  "vars": {
    "TEAM_DOMAIN": "cool-band-b0ac.cloudflareaccess.com",
    "POLICY_AUD": "00b16ce0458e7c71412274f37b60a7d64401d4b9b164fdd4d69baea786de23f7"
  }
}
